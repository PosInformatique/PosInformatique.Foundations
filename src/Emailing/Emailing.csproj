<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>

    <Description>
      Provides a lightweight, template-based emailing infrastructure for .NET.
      Allows registering strongly-typed email templates, instantiating emails from models, and sending them through pluggable providers (e.g. Azure Communication Service).
    </Description>
    <PackageTags>
      email;emailing;templating;razor;scriban;dotnet;posinformatique;azure;communication;service;provider;dependencyinjection
    </PackageTags>
    <PackageReleaseNotes>
      $([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/CHANGELOG.md"))
    </PackageReleaseNotes>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmailAddresses\EmailAddresses.csproj" />
    <ProjectReference Include="..\MediaTypes\MediaTypes.csproj" />
    <ProjectReference Include="..\Text.Templating\Text.Templating.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="CHANGELOG.md" Pack="false" />
    <Content Include="Icon.png" Pack="true" PackagePath="" />
    <Content Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
